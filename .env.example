# GEO Measurement Platform — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Never commit real secrets. Never log these values.

# AI engine API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# Supabase (Postgres) storage
SUPABASE_URL=
# The SERVICE-ROLE key. Bypasses RLS entirely — used for system-level work only
# (the judge caches, engine fingerprints, the crawler, the worker queue), and for
# everything running outside a request: the CLI, the orchestrator, the resume scan.
SUPABASE_KEY=
# The ANON (publishable) key. A connection made with this one is SUBJECT to RLS,
# which is exactly why per-user reads use it, with the caller's access token as
# the bearer on top (LIC-T7). Required once any route is listed in
# JWT_MIGRATED_ROUTES; per-user access REFUSES rather than falling back to the
# service-role key, because a fallback would silently bypass every policy.
SUPABASE_ANON_KEY=

# Google AI Overviews + AI Mode are captured via DataForSEO — see DATAFORSEO_LOGIN /
# DATAFORSEO_PASSWORD below. (SearchApi.io served this until 2026-07-28; removed for
# its $40/month floor.)

# --- API security (FastAPI layer) ---
# Shared key required on every API endpoint (sent as the X-API-Key header).
# UNSET = the API is OPEN (local dev only) — SET THIS before exposing the API.
# The Next.js frontend must send the same value as NEXT_PUBLIC_GEO_API_KEY
# (in web/.env.local). Note: NEXT_PUBLIC_* ships to the browser, so this gates
# anonymous access, not per-user access — keep the frontend itself protected.
GEO_API_KEY=
# HMAC secret for signed share links (src/api/sharing.py). SEPARATE from
# GEO_API_KEY since LIC-T11 — before that, one value was both the API credential
# and the signature on every client report link, so rotating or retiring the
# credential silently killed every outstanding link.
# UNSET = falls back to GEO_API_KEY, which keeps existing links verifying and is
# the correct setting until you deliberately complete the split. To separate them:
# set this to its own random value and keep SHARE_ACCEPT_LEGACY_SIGNATURE=1 until
# every link signed with the old secret has expired (default TTL is 30 days).
SHARE_SIGNING_KEY=
# Honour links still signed with the OLD secret (GEO_API_KEY). 1 = yes (the
# deprecation window). Set 0 to close it — a deliberate act, not a deploy side
# effect: any link still signed with the old secret stops working that moment.
SHARE_ACCEPT_LEGACY_SIGNATURE=1
# Per-user auth (LIC-T6): comma-separated path prefixes whose routes require a
# verified Supabase JWT instead of GEO_API_KEY. Empty = nothing has migrated and
# the API behaves exactly as before. A migrated route REFUSES the shared key and
# an unmigrated one refuses a bearer token, so no route ever accepts both.
# Migrate one prefix at a time — this is where "assumed there is one tenant" bugs
# surface, and they should surface on one endpoint, not all of them at once.
# Requires SUPABASE_ANON_KEY. Example: JWT_MIGRATED_ROUTES=/projects,/companies
# The fact-sheet intake surface (LIC-T18) migrates as a unit — both prefixes or
# neither, or an agency's onboarding flow keeps one endpoint on the shared key:
#   JWT_MIGRATED_ROUTES=/intake,/fact-sheets
# (`src.api.app.INTAKE_PREFIXES` is the authoritative list; a test asserts every
# intake route falls under it.)
JWT_MIGRATED_ROUTES=
# How long a fetched JWKS key set is reused before re-fetching (seconds). Bounded
# so a ROTATED signing key is picked up without a redeploy.
JWKS_CACHE_SECONDS=600
# Allowed browser origins for CORS (comma-separated). Default: http://localhost:3000.
# Set to your deployed frontend URL(s) in production — never "*".
GEO_CORS_ORIGINS=http://localhost:3000
# Cloudflare Turnstile (LIC-T15) — the cheapest abuse gate, verified server-side
# before anything touches the DB or spends tokens. Both unset = gate OFF (correct
# for local dev; must be SET before the public lead form is exposed).
# The SITE key is public and also belongs in web/.env.local as
# NEXT_PUBLIC_TURNSTILE_SITE_KEY. The SECRET key is server-side only — it is the
# siteverify credential and must never reach the browser, a response or a log.
# Widget hostnames are managed in the Cloudflare dashboard; `localhost` is the
# entry for local dev (no scheme, no port). For tests, use the dummy keys that
# pass on any hostname: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Redis — per-IP/per-domain rate limits (LIC-T15) and the arq job queue (LIC-T16),
# one instance for both. Must be the TCP endpoint, NOT Upstash's REST URL/token:
#   rediss://default:<password>@<name>.upstash.io:6379
# Unset = both off (neither is built yet). Nothing durable lives here — counters
# expire by design and queued jobs are transient; Postgres stays the record.
REDIS_URL=

# Abuse / cost ceilings on a single uploaded audit (enforced before any LLM call).
MAX_UPLOAD_BYTES=5242880
MAX_QUERIES=200
MAX_ENGINES=8
MAX_RUNS_PER_QUERY=5
# Spend guard (rough estimated USD, engines + judge) — the hard cap on burning
# credits. A single audit over MAX_AUDIT_COST_USD is refused (402); once accepted
# audits this process would exceed MAX_TOTAL_SPEND_USD, further runs are refused.
# Cumulative total resets on API restart. Set either to 0 to disable that check.
MAX_AUDIT_COST_USD=25
MAX_TOTAL_SPEND_USD=200

# Isolation & determinism controls (docs/isolation-determinism-plan.md)
# Best-effort reproducibility seed sent to providers that accept one (OpenAI, Gemini).
ENGINE_SEED=42
# Optional: append every outgoing engine request body (secrets scrubbed) as JSON
# lines to this file, so any run is reconstructable. Unset = debug logging only.
PAYLOAD_LOG_PATH=

# --- Cat 6 offsite research agent (all optional; tools degrade without keys) ---
# Wikidata needs no key and always runs (baseline entity lookup). The on-site
# checks (SSR/schema/links) also need none of these. Verify what's active with:
#   python -m src.audit.offsite Notion notion.so
#
# ► RECOMMENDED — Serper.dev (Google SERP data). The one key that matters: it's
#   the agent's web search + powers review/listicle/press discovery. Without it
#   the agent loop is skipped and Cat 6 is just the Wikidata baseline. ~$1/1k
#   searches (free starter credits); capped at ~5 searches/audit. Key at
#   https://serper.dev (Dashboard → API Key).
SERPER_API_KEY=
#
# OPTIONAL — Reddit Data API. Adds native Reddit data (subreddit/score); without
# it, Reddit threads still surface via Serper's site:reddit.com searches. Free —
# create a "script" app at https://www.reddit.com/prefs/apps (100 QPM).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=geo-audit/0.1 (offsite research)
#
# RECOMMENDED — DataForSEO now covers TWO things, and is the cheaper of the two
# possible Google AI Overviews vendors:
#   1. AI Overviews capture (src/engines/dataforseo_ai_overviews.py). Pay-as-you-go,
#      NO monthly fee: ~$0.002/SERP live. When these credentials are set, the
#      google_ai_overviews surface uses DataForSEO instead of SearchApi — same engine
#      name, same measurements, no other config changes. SearchApi's cheapest plan is
#      $40/month for volume an audit will never use, so this is the default choice.
#   2. Backlinks summary for the Cat 6 offsite agent (informational; not a roadmap gap).
# Registration is free and needs no card, and comes with $1 of credit — roughly 500
# calls, enough to verify the whole path before depositing anything. The $50 minimum
# only applies to topping up. Login/password from https://app.dataforseo.com.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Direct Postgres connection string, used ONLY to apply DDL from
# data/*.sql — the SUPABASE_KEY above is a REST key and cannot run
# `alter table`. Optional: leave unset and apply migrations by hand in
# the Supabase SQL editor. Format:
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# The WEBSITE's Supabase project (the `leads` table) — a DIFFERENT database from
# SUPABASE_URL above. Read ONLY by the fact-sheet worker
# (`python -m src.cli factsheet-worker`), which polls for businesses needing a
# Tier-1 sheet. Optional: unset means the worker does not run.
#
# Use the SELECT-only `leads_reader` role created by
# geoWebsite/scripts/leads-visibility.sql — never the postgres superuser, never
# the service_role key. The worker carries `leads.id` across and nothing else;
# no prospect email or phone ever reaches the platform project.
#   postgresql://leads_reader:<password>@db.<leads-project-ref>.supabase.co:5432/postgres
LEADS_DB_URL=
